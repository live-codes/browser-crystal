# node_modules, in case you installed the libLLVM package in order to rebuild the compiler
# (`npm install --save-dev @live-codes/llvm-wasm`). The page and the language package need
# nothing installed; this is a build-time dependency of the compiler pipeline.
node_modules/

# Python bytecode from patches/apply-patches.py, which lives in the llvm-wasm repository now.
__pycache__/
*.pyc

# The global script build (packages/crystal-wasm/scripts/build-iife.mjs), which is what a
# page loads from a CDN. Built at publish time; the package's `prepack` makes it.
packages/crystal-wasm/dist/

# The language package's payload (packages/crystal-wasm/build-assets.sh): about 22 MB
# gzipped — the compiler (12 MB of it), the linker (8 MB), the standard library
# (1.3 MB) and the sysroot archives. Too large to commit; regenerate with
# `npm run demo:assets` (Linux or WSL). The receipts that pin its bytes are
# committed, and `npm pack` refuses to publish without matching assets.
packages/crystal-wasm/assets/crystal/
