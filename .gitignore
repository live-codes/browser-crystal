# Cross-compile intermediates: the wasm objects Crystal emits, and one build log
# per sample. Only public/crystal/*.wasm is needed at run time, and that is
# committed so a clone runs without Docker.
# build/objects/


# libLLVM for wasm (build/llvm-wasm/): the source tarball, host tblgen and cross
# build tree live under WORK/CACHE outside the repo; only the packaged result
# would land in out/, and it is far too large to commit. Rebuild with
# `npm run build:llvm-wasm` (Linux or WSL).
# build/llvm-wasm/out/

# Python bytecode from patches/apply-patches.py
__pycache__/
*.pyc

# Outputs of verify/run-probe.sh (regenerated on every verify)
build/llvm-wasm/verify/*.o
build/llvm-wasm/verify/*.wasm

# The in-browser demo's payload (build/crystal-wasm/demo-assets.sh): an 80 MB
# compiler, a 21 MB linker, a 10 MB stdlib and the sysroot archives. Too large to
# commit; regenerate with `npm run demo:assets` (Linux or WSL). public/vendor/ is
# small and committed, so the page itself needs no build step.
public/crystal-demo/
