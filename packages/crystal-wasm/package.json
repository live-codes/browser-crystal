{
  "name": "@live-codes/crystal-wasm",
  "version": "0.1.1",
  "description": "Run Crystal in the browser, on the Crystal compiler compiled to WebAssembly",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/live-codes/browser-crystal",
    "directory": "packages/crystal-wasm"
  },
  "exports": {
    ".": {
      "node": "./src/index.node.js",
      "browser": "./src/index.js",
      "default": "./src/index.js"
    },
    "./iife": "./dist/crystal-wasm.global.js"
  },
  "bin": {
    "crystal-wasm-copy-assets": "./bin/copy-assets.mjs"
  },
  "files": [
    "src",
    "bin",
    "scripts",
    "dist",
    "docs",
    "assets",
    "vendor",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets": "bash build-assets.sh",
    "receipts": "node scripts/write-receipts.mjs",
    "build:iife": "node scripts/build-iife.mjs",
    "prepack": "node scripts/build-iife.mjs && node scripts/check-assets.mjs",
    "test": "node --experimental-wasm-exnref --test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "crystal",
    "wasm",
    "webassembly",
    "compiler",
    "playground"
  ]
}
